TELEGRAM_BOT_TOKEN=your_bot_token_here
DB_PATH=./data/prices.db
POLL_INTERVAL_MINUTES=60
# Интервал опроса поисковых страниц Avito (новые товары), в минутах (default: 5)
AVITO_POLL_INTERVAL_MINUTES=5
# Интервал книжного обхода Avito (/books), в минутах (default: 5)
AVITO_BOOKS_POLL_INTERVAL_MINUTES=5
# Отдельный Chrome-профиль для ценового режима Avito (/add).
# Не трогать — создаётся автоматически.
AVITO_PROFILE_DIR=./chrome_profile_avito
# Отдельный Chrome-профиль для книжного режима Avito (/books), чтобы оба
# режима могли работать параллельно с разными SingletonLock.
# Каталоги должны быть разными: если они совпадут, книжный режим не запустится.
AVITO_BOOKS_PROFILE_DIR=./chrome_profile_avito_books
# SOCKS5 proxy for Telegram bot (optional)
# Format: socks5://login:pass@host:port
PROXY_URL=
# Пауза до следующей проверки, если Avito вернул заглушку «Доступ ограничен», в минутах (default: 5)
AVITO_BLOCK_RETRY_MINUTES=5
# Сколько подряд таких проверок терпеть, прежде чем уведомить админа (default: 3)
AVITO_BLOCK_MAX_ATTEMPTS=3
# Книжный режим Avito (/books): сколько карточек объявлений открывать за цикл
AVITO_BOOKS_MAX_CHECKS=8
# Сколько страниц выдачи обходить за один цикл (общий лимит на все книжные
# ссылки домена) и максимум страниц на одну ссылку до встречи известных лотов
AVITO_BOOKS_PAGES_PER_CYCLE=4
AVITO_BOOKS_MAX_PAGES=10
# Пауза между страницами одной выдачи, в секундах (min/max для random)
AVITO_BOOKS_PAGE_DELAY_MIN=5
AVITO_BOOKS_PAGE_DELAY_MAX=7
# 1 — только логировать совпадения, не отправлять уведомления (калибровка)
AVITO_BOOKS_DRY_RUN=0
# LLM-проверка спорных лотов (год/издательство не указаны или несколько
# изданий одного названия). 1 — включена, 0 — только детерминированный матчер
AVITO_BOOKS_LLM_ENABLED=1
# Как часто разбирать очередь LLM-проверки, в минутах
AVITO_BOOKS_LLM_INTERVAL_MINUTES=10
# Сколько спорных лотов проверять за один проход очереди
AVITO_BOOKS_LLM_BATCH=3