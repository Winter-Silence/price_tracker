[Unit]
Description=Price Tracker Telegram Bot
After=network.target price-tracker-xvfb.service price-tracker-fluxbox.service
Requires=price-tracker-xvfb.service price-tracker-fluxbox.service

[Service]
Type=simple
User=yury
WorkingDirectory=/home/yury/projects/price_tracker
Environment=DISPLAY=:99
EnvironmentFile=-/home/yury/projects/price_tracker/.env
ExecStart=/home/yury/.local/share/mise/installs/python/3.14.10/bin/python main.py
Restart=always
RestartSec=10
PrivateTmp=true

[Install]
WantedBy=multi-user.target
