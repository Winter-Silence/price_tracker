TELEGRAM_BOT_TOKEN=your_bot_token_here
DB_PATH=./data/prices.db
POLL_INTERVAL_MINUTES=60
# Интервал опроса поисковых страниц Avito (новые товары), в минутах (default: 5)
AVITO_POLL_INTERVAL_MINUTES=5
# Отдельный Chrome-профиль для Avito (чтобы его 5-минутный опрос не
# конфликтовал с часовым циклом отслеживания цен). Не трогать — создаётся автоматически.
AVITO_PROFILE_DIR=./chrome_profile_avito
# SOCKS5 proxy for Telegram bot (optional)
# Format: socks5://login:pass@host:port
PROXY_URL=