# SSH host (or IP) of the production server
DEPLOY_HOST=your-server.example.com

# SSH username (must have passwordless sudo for `systemctl restart`)
DEPLOY_USER=yury

# SSH port (default: 22)
DEPLOY_PORT=22

# Absolute path to the project on the server
DEPLOY_PATH=/home/yury/price_tracker

# Branch to deploy (default: main)
DEPLOY_BRANCH=main

# Optional: paths to the Avito Chrome profiles on the server.
# Relative paths are resolved against the service WorkingDirectory
# (systemctl show price-tracker.service --property=WorkingDirectory).
# If not set here, the values from the server .env are used, and if those
# are missing too — the defaults ./chrome_profile_avito and
# ./chrome_profile_avito_books.
# AVITO_PROFILE_DIR=./chrome_profile_avito
# AVITO_BOOKS_PROFILE_DIR=./chrome_profile_avito_books

# Optional: path to SSH private key (e.g., ~/.ssh/id_ed25519)
# Leave empty to use ssh-agent / default keys.
DEPLOY_SSH_KEY=
