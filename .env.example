TELEGRAM_BOT_TOKEN=your_bot_token_here
DB_PATH=./data/prices.db
POLL_INTERVAL_MINUTES=60
# Интервал опроса поисковых страниц Avito (новые товары), в минутах (default: 5)
AVITO_POLL_INTERVAL_MINUTES=5
# Отдельный Chrome-профиль для Avito (чтобы его 5-минутный опрос не
# конфликтовал с часовым циклом отслеживания цен). Не трогать — создаётся автоматически.
AVITO_PROFILE_DIR=./chrome_profile_avito
# SOCKS5 proxy for Telegram bot (optional)
# Format: socks5://login:pass@host:port
PROXY_URL=
# Пауза до следующей проверки, если Avito вернул заглушку «Доступ ограничен», в минутах (default: 5)
AVITO_BLOCK_RETRY_MINUTES=5
# Сколько подряд таких проверок терпеть, прежде чем уведомить админа (default: 3)
AVITO_BLOCK_MAX_ATTEMPTS=3
# Книжный режим Avito (/books): сколько карточек объявлений открывать за цикл
AVITO_BOOKS_MAX_CHECKS=15
# 1 — только логировать совпадения, не отправлять уведомления (калибровка)
AVITO_BOOKS_DRY_RUN=0